{
	"name": "@vetta/vetta-mcp",
	"version": "0.0.1",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./bin": {
			"types": "./dist/bin.d.ts",
			"default": "./dist/bin.js"
		}
