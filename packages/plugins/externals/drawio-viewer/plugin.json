{
	"id": "drawio-viewer",
	"name": "Draw.io Viewer",
	"version": "0.2.0",
	"pluginApiVersion": "^1.0.0",
	"runtime": "module-federation",
	"entry": "dist/mf-manifest.json",
	"moduleFederation": {
		"remoteName": "drawio_viewer",
		"expose": "./plugin"
	},
	"styles": ["dist/style.css"],
	"permissions": ["ui.slot.file-preview"],
	"description": "Preview .drawio / .dio diagrams offline with a bundled draw.io viewer engine.",
	"author": "Vetta"
}
