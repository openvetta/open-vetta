{
	"id": "lottie-studio",
	"name": "Lottie Studio",
	"version": "0.1.0",
	"pluginApiVersion": "^1.0.0",
	"runtime": "module-federation",
	"entry": "dist/mf-manifest.json",
	"moduleFederation": {
		"remoteName": "lottie_studio",
		"expose": "./plugin"
	},
	"styles": ["dist/style.css"],
	"permissions": [
		"ui.slot.input-action",
		"ui.slot.tool-call",
		"ui.slot.activity-tab",
		"ui.slot.file-preview",
		"agent.tools.register",
		"agent.toolHandler.execute",
		"fs.read",
		"fs.write"
	],
	"description": "用 AI 生成 Lottie 动画，并在侧边活动面板用 Skia/Skottie 实时预览与编辑可调属性（slot）。",
	"author": "Vetta",
	"guidingWords": ["做一个加载中的 Lottie 动画", "生成一个弹跳小球的 Lottie 动画"]
}
