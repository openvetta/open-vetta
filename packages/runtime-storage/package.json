{
	"name": "@vetta/runtime-storage",
	"version": "0.0.1",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./conversation": {
			"types": "./dist/conversation/index.d.ts",
			"import": "./dist/conversation/index.js"
		}
	},
	"files": ["dist"],
	"scripts": {
		"clean": "rm -rf dist",
		"build": "bun run build:runtime && bun run build:compat",
		"build:runtime": "tsgo -p tsconfig.runtime.json",
		"build:compat": "tsgo -p tsconfig.compat.json",
		"test": "bunx vitest --run"
	},
	"dependencies": {
		"@sinclair/typebox": "^0.34.41",
		"@vetta/runtime-core": "workspace:*"
	},
	"peerDependencies": {
		"@vetta/coding-agent": "workspace:*"
	},
	"devDependencies": {
		"@vetta/coding-agent": "workspace:*",
		"typescript": "^5.9.2",
		"@types/node": "^22.10.5"
	}
}
