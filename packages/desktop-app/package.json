{
	"name": "@vetta/desktop-app",
	"version": "0.0.1",
	"description": "Vetta Desktop App",
	"author": "Vetta",
	"type": "module",
	"private": true,
	"main": "dist/main/index.js",
	"scripts": {
		"clean": "rm -rf dist",
		"build:preload": "vite build --config vite.preload.config.ts",
		"build:renderer": "vite build --config vite.config.ts",
		"build:main": "vite build --config vite.main.config.ts",
		"build": "bun run build:preload && bun run build:renderer && bun run build:main",
		"start": "bun run build && NODE_OPTIONS='--import tsx' electron src/main/main.ts",
		"dev": "bun run build:preload && bun run build:main && concurrently -k \"vite --config vite.config.ts\" \"wait-on tcp:5173 && cross-env VETTA_DESKTOP_DEV_URL=http://127.0.0.1:5173 electron dist/main/index.js\"",
		"prebuild:pack": "bun run build && node scripts/prepare-pack.js",
		"pack": "bun run prebuild:pack && bunx electron-builder --mac --dir --project \"$TMPDIR/vetta-desktop-build\" --config \"$TMPDIR/vetta-desktop-build/electron-builder.json\"",
		"dist:mac": "bun run prebuild:pack && bunx electron-builder --mac --project \"$TMPDIR/vetta-desktop-build\" --config \"$TMPDIR/vetta-desktop-build/electron-builder.json\""
	},
	"dependencies": {
		"@dagrejs/dagre": "^3.0.0",
		"@fontsource-variable/geist": "^5.2.8",
		"@mariozechner/pi-ai": "workspace:*",
		"@tanstack/react-router": "^1.130.15",
		"@types/adm-zip": "^0.5.8",
		"@vetta/runtime-core": "workspace:*",
		"@xyflow/react": "^12.10.2",
		"adm-zip": "^0.5.16",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"date-fns": "^4.1.0",
		"dotenv": "^17.3.1",
		"jotai": "^2.15.1",
		"lucide-react": "^1.6.0",
		"mammoth": "^1.12.0",
		"motion": "^12.23.12",
		"pdfjs-dist": "4.10.38",
		"qrcode": "^1.5.4",
		"radix-ui": "^1.4.3",
		"react": "^19.1.1",
		"react-day-picker": "^9.14.0",
		"react-dom": "^19.1.1",
		"react-markdown": "^10.1.0",
		"react-virtuoso": "^4.18.5",
		"rehype-highlight": "^7.0.2",
		"remark-gfm": "^4.0.1",
		"shadcn": "^4.1.0",
		"shiki": "^4.0.2",
		"tailwind-merge": "^3.5.0",
		"toad-scheduler": "^3.1.0",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@iconify-json/mdi": "^1.2.3",
		"@iconify/tailwind4": "^1.0.6",
		"@tailwindcss/vite": "^4.1.12",
		"@types/node": "^22.10.5",
		"@types/qrcode": "^1.5.5",
		"@types/react": "^19.1.1",
		"@types/react-dom": "^19.1.1",
		"@vitejs/plugin-react": "^5.0.0",
		"concurrently": "^9.2.1",
		"cross-env": "^10.1.0",
		"electron": "^34.2.0",
		"electron-builder": "^26.8.1",
		"tailwindcss": "^4.1.12",
		"typescript": "^5.9.2",
		"vite": "^7.1.7",
		"wait-on": "^9.0.1"
	}
}
