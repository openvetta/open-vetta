{
	"name": "@vetta/desktop-app",
	"version": "0.1.16",
	"description": "Vetta Desktop App",
	"author": "Vetta",
	"type": "module",
	"private": true,
	"main": "dist/main/index.js",
	"scripts": {
		"clean": "rm -rf dist",
		"build:preload": "vite build --config vite.preload.config.ts",
		"build:renderer": "vite build --config vite.config.ts",
		"build:main": "vite build --config vite.main.config.ts",
		"build:ocr-preload": "vite build --config vite.ocr-preload.config.ts",
		"build:ocr-runner": "vite build --config vite.ocr-runner.config.ts",
		"build": "bun run build:preload && bun run build:ocr-preload && bun run build:renderer && bun run build:ocr-runner && bun run build:main",
		"prepare:windows": "node scripts/prepare-windows-prereqs.js",
		"prepare:ocr-models": "node scripts/fetch-ocr-models.js",
		"start": "bun run prepare:windows && bun run prepare:ocr-models && bun run build && NODE_OPTIONS='--import tsx' electron src/main/main.ts",
		"dev": "bun run prepare:windows && bun run prepare:ocr-models && bun run build:preload && bun run build:ocr-preload && bun run build:ocr-runner && cross-env VETTA_BUILD_ENV=development bun run build:main && concurrently -k \"vite --config vite.config.ts\" \"wait-on tcp:3000 && cross-env VETTA_DESKTOP_DEV_URL=http://127.0.0.1:3000 electron dist/main/index.js\"",
		"prepare:bwrap": "node scripts/prepare-bwrap.js",
		"prebuild:pack": "bun run prepare:windows && bun run prepare:bwrap && bun run prepare:ocr-models && bun run build && node scripts/prepare-pack.js",
		"dist:desktop": "bun run prebuild:pack && node scripts/run-electron-builder.js",
		"pack": "bun run dist:desktop -- --target dir",
		"pack:linux": "bun run dist:desktop -- --platform linux --target dir",
		"pack:win": "bun run dist:desktop -- --platform win --target dir",
		"pack:test": "cross-env VETTA_BUILD_ENV=test bun run pack",
		"pack:linux:test": "cross-env VETTA_BUILD_ENV=test bun run pack:linux",
		"pack:win:test": "cross-env VETTA_BUILD_ENV=test bun run pack:win",
		"dist:mac": "bun run dist:desktop -- --platform mac",
		"dist:linux": "bun run dist:desktop -- --platform linux",
		"dist:win": "bun run dist:desktop -- --platform win",
		"dist:mac:test": "cross-env VETTA_BUILD_ENV=test bun run dist:mac",
		"dist:linux:test": "cross-env VETTA_BUILD_ENV=test bun run dist:linux",
		"dist:win:test": "cross-env VETTA_BUILD_ENV=test bun run dist:win",
		"dist:linux:appimage": "bun run dist:desktop -- --platform linux --target AppImage",
		"dist:linux:deb": "bun run dist:desktop -- --platform linux --target deb",
		"dist:linux:rpm": "bun run dist:desktop -- --platform linux --target rpm",
		"dist:linux:tar.gz": "bun run dist:desktop -- --platform linux --target tar.gz",
		"dist:win:nsis": "bun run dist:desktop -- --platform win --target nsis",
		"dist:win:portable": "bun run dist:desktop -- --platform win --target portable",
		"dist:win:zip": "bun run dist:desktop -- --platform win --target zip",
		"dist:linux:appimage:test": "cross-env VETTA_BUILD_ENV=test bun run dist:linux:appimage",
		"dist:linux:deb:test": "cross-env VETTA_BUILD_ENV=test bun run dist:linux:deb",
		"dist:linux:rpm:test": "cross-env VETTA_BUILD_ENV=test bun run dist:linux:rpm",
		"dist:linux:tar.gz:test": "cross-env VETTA_BUILD_ENV=test bun run dist:linux:tar.gz",
		"dist:win:nsis:test": "cross-env VETTA_BUILD_ENV=test bun run dist:win:nsis",
		"dist:win:portable:test": "cross-env VETTA_BUILD_ENV=test bun run dist:win:portable",
		"dist:win:zip:test": "cross-env VETTA_BUILD_ENV=test bun run dist:win:zip"
	},
	"dependencies": {
		"@dagrejs/dagre": "^3.0.0",
		"@fontsource-variable/geist": "^5.2.8",
		"@mariozechner/pi-ai": "workspace:*",
		"@ocr-web/core": "^0.2.1",
		"@ocr-web/models-ppocrv5": "^0.1.1",
		"@silvia-odwyer/photon-node": "^0.3.4",
		"@tanstack/react-router": "^1.130.15",
		"@types/adm-zip": "^0.5.8",
		"@vetta/runtime-core": "workspace:*",
		"@xyflow/react": "^12.10.2",
		"adm-zip": "^0.5.16",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"date-fns": "^4.1.0",
		"dbus-next": "^0.10.2",
		"dotenv": "^17.3.1",
		"electron-log": "^5.4.4",
		"jotai": "^2.15.1",
		"lucide-react": "^1.6.0",
		"mammoth": "^1.12.0",
		"minimatch": "^10.1.1",
		"motion": "^12.23.12",
		"onnxruntime-web": "^1.25.1",
		"pdfjs-dist": "4.10.38",
		"qrcode": "^1.5.4",
		"radix-ui": "^1.4.3",
		"react": "^19.1.1",
		"react-day-picker": "^9.14.0",
		"react-dom": "^19.1.1",
		"react-markdown": "^10.1.0",
		"react-virtuoso": "^4.18.5",
		"rehype-highlight": "^7.0.2",
		"remark-gfm": "^4.0.1",
		"shadcn": "^4.1.0",
		"shiki": "^4.0.2",
		"tailwind-merge": "^3.5.0",
		"toad-scheduler": "^3.1.0",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@iconify-json/mdi": "^1.2.3",
		"@iconify/tailwind4": "^1.0.6",
		"@tailwindcss/vite": "^4.1.12",
		"@types/node": "^22.10.5",
		"@types/qrcode": "^1.5.5",
		"@types/react": "^19.1.1",
		"@types/react-dom": "^19.1.1",
		"@vitejs/plugin-react": "^5.0.0",
		"concurrently": "^9.2.1",
		"cross-env": "^10.1.0",
		"electron": "^34.2.0",
		"electron-builder": "^26.8.1",
		"tailwindcss": "^4.1.12",
		"typescript": "^5.9.2",
		"vite": "^7.1.7",
		"wait-on": "^9.0.1"
	}
}
