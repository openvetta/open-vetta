{
	"name": "@vetta/desktop-app",
	"version": "0.0.1",
	"type": "module",
	"private": true,
	"scripts": {
		"clean": "rm -rf dist",
		"build:preload": "vite build --config vite.preload.config.ts",
		"build:renderer": "vite build --config vite.config.ts",
		"build": "bun run build:preload && bun run build:renderer",
		"start": "bun run build && NODE_OPTIONS='--import tsx' electron src/main/main.ts",
		"dev": "bun run build:preload && concurrently -k \"vite --config vite.config.ts\" \"wait-on tcp:5173 && NODE_OPTIONS='--import tsx' VETTA_DESKTOP_DEV_URL=http://127.0.0.1:5173 electron src/main/main.ts\""
	},
	"dependencies": {
		"@vetta/runtime-core": "workspace:*",
		"@tanstack/react-router": "^1.130.15",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"jotai": "^2.15.1",
		"motion": "^12.23.12",
		"react": "^19.1.1",
		"react-dom": "^19.1.1",
		"tailwind-merge": "^3.3.1"
	},
	"devDependencies": {
		"@iconify-json/mdi": "^1.2.3",
		"@iconify/tailwind4": "^1.0.6",
		"@tailwindcss/vite": "^4.1.12",
		"@types/node": "^22.10.5",
		"@types/react": "^19.1.1",
		"@types/react-dom": "^19.1.1",
		"@vitejs/plugin-react": "^5.0.0",
		"concurrently": "^9.2.1",
		"electron": "^34.2.0",
		"tailwindcss": "^4.1.12",
		"wait-on": "^9.0.1",
		"typescript": "^5.9.2",
		"vite": "^7.1.7"
	}
}
