{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"jsx": "react-jsx",
		"noEmit": true,
		"paths": {
			"@/*": ["./src/*"],
			"@shared/*": ["./src/renderer/shared/*"],
			"@domains/*": ["./src/renderer/domains/*"],
			"@preload/*": ["./src/preload/*"],
			"@vetta/ai": ["../ai/src/index.ts"],
			"@vetta/ai/*": ["../ai/src/*"],
			"@vetta/agent-core": ["../agent/src/index.ts"],
			"@vetta/agent-core/*": ["../agent/src/*"],
			"@vetta/coding-agent": ["../coding-agent/src/index.ts"],
			"@vetta/coding-agent/*": ["../coding-agent/src/*"],
			"@vetta/runtime-core": ["../runtime-core/src/index.ts"],
			"@vetta/runtime-core/*": ["../runtime-core/src/*"],
			"@vetta/plugin-sdk": ["../plugins/plugin-sdk/src/index.ts"],
			"@vetta/plugin-sdk/*": ["../plugins/plugin-sdk/src/*"],
			"@vetta/runtime-telemetry": ["../runtime-telemetry/src/index.ts"],
			"@vetta/runtime-telemetry/langfuse": ["../runtime-telemetry/src/langfuse.ts"],
			"@vetta/runtime-telemetry/*": ["../runtime-telemetry/src/*"],
			"@vetta/action-rpc": ["../action-rpc/src/index.ts"],
			"@vetta/action-rpc/*": ["../action-rpc/src/*"]
		},
		"allowImportingTsExtensions": true
	},
	"include": ["./**/*.ts", "./**/*.tsx", "./**/*.d.ts"],
	"exclude": ["node_modules", "../preload", "../../runtime-core"]
}
