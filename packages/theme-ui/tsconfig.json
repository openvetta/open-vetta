{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"noEmit": true,
		"types": ["react"],
		"paths": {
			"@vetta/theme-sdk": ["../theme-sdk/src/index.ts"],
			"@vetta/theme-sdk/*": ["../theme-sdk/src/*"],
			"@vetta/ui": ["../ui/src/index.ts"],
			"@vetta/ui/*": ["../ui/src/*"]
		}
	},
	"include": ["src/**/*.ts", "src/**/*.tsx"],
	"exclude": ["node_modules", "dist"]
}
