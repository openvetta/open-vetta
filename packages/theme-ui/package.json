		},
		"./app-shell": {
			"types": "./src/app-shell/index.ts",
			"import": "./src/app-shell/index.ts"
		},
		"./chat": {
			"types": "./src/chat/index.ts",
			"import": "./src/chat/index.ts"
		},
		"./file-preview": {
			"types": "./src/file-preview/index.ts",
			"import": "./src/file-preview/index.ts"
		},
		"./knowledge": {
			"types": "./src/knowledge/index.ts",
			"import": "./src/knowledge/index.ts"
		},
		"./layout": {
			"types": "./src/layout/index.ts",
