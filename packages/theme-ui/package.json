	"peerDependencies": {
		"canvas-confetti": "^1.9.0",
		"motion": "^12.0.0",
		"react": "^19.0.0",
		"react-markdown": "^10.0.0",
		"remark-gfm": "^4.0.0",
		"shiki": ">=3.0.0"
	},
	"peerDependenciesMeta": {
		"canvas-confetti": { "optional": true },
		"react-markdown": { "optional": true },
		"remark-gfm": { "optional": true },
		"shiki": { "optional": true }
	},
	"devDependencies": {
		"@types/canvas-confetti": "^1.9.0",
