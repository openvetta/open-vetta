{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"paths": {
			"*": ["./*"],
			"@vetta/coding-agent": ["./packages/coding-agent/src/index.ts"],
			"@vetta/coding-agent/*": ["./packages/coding-agent/src/*"],
			"@mariozechner/pi-ai": ["./packages/ai/src/index.ts"],
			"@mariozechner/pi-ai/*": ["./packages/ai/src/*"],
			"@mariozechner/pi-ai/dist/*": ["./packages/ai/src/*"],
			"@mariozechner/pi-agent-core": ["./packages/agent/src/index.ts"],
			"@mariozechner/pi-agent-core/*": ["./packages/agent/src/*"],
			"@mariozechner/pi-coding-agent": ["./packages/coding-agent/src/index.ts"],
			"@mariozechner/pi-coding-agent/hooks": ["./packages/coding-agent/src/core/hooks/index.ts"],
			"@mariozechner/pi-coding-agent/*": ["./packages/coding-agent/src/*"],
			"@sinclair/typebox": ["./node_modules/@sinclair/typebox"],
			"@vetta/runtime-core": ["./packages/runtime-core/src/index.ts"],
			"@vetta/runtime-core/*": ["./packages/runtime-core/src/*"],
			"@vetta/action-rpc": ["./packages/action-rpc/src/index.ts"],
			"@vetta/action-rpc/*": ["./packages/action-rpc/src/*"],
			"@vetta/plugin-sdk": ["./packages/plugin-sdk/src/index.ts"],
			"@vetta/plugin-sdk/*": ["./packages/plugin-sdk/src/*"],
			"@vetta/plugin-vite": ["./packages/plugin-vite/src/index.ts"],
			"@vetta/plugin-vite/*": ["./packages/plugin-vite/src/*"],
			"@vetta/runtime-tools": ["./packages/runtime-tools/src/index.ts"],
			"@vetta/runtime-tools/*": ["./packages/runtime-tools/src/*"],
			"@vetta/runtime-mcp": ["./packages/runtime-mcp/src/index.ts"],
			"@vetta/runtime-mcp/*": ["./packages/runtime-mcp/src/*"],
			"@vetta/runtime-storage": ["./packages/runtime-storage/src/index.ts"],
			"@vetta/runtime-storage/*": ["./packages/runtime-storage/src/*"],
			"@vetta/runtime-telemetry": ["./packages/runtime-telemetry/src/index.ts"],
			"@vetta/runtime-telemetry/langfuse": ["./packages/runtime-telemetry/src/langfuse.ts"],
			"@vetta/runtime-telemetry/*": ["./packages/runtime-telemetry/src/*"],
			"@vetta/cli-app": ["./packages/cli-app/src/index.ts"],
			"@vetta/cli-app/*": ["./packages/cli-app/src/*"],
			"@mariozechner/pi-agent-old": ["./packages/agent-old/src/index.ts"],
			"@mariozechner/pi-agent-old/*": ["./packages/agent-old/src/*"]
		}
	},
	"include": [
		"packages/ai/src/**/*",
		"packages/ai/test/**/*",
		"packages/agent/src/**/*",
		"packages/agent/test/**/*",
		"packages/coding-agent/src/**/*",
		"packages/coding-agent/test/**/*",
		"packages/runtime-core/src/**/*",
		"packages/action-rpc/src/**/*",
		"packages/plugin-sdk/src/**/*",
		"packages/plugin-vite/src/**/*",
		"packages/runtime-tools/src/**/*",
		"packages/runtime-mcp/src/**/*",
		"packages/runtime-storage/src/**/*",
		"packages/runtime-telemetry/src/**/*",
		"packages/cli-app/src/**/*",
		"packages/coding-agent/examples/**/*"
	],
	"exclude": ["**/dist/**"]
}
